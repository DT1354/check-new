# 单账号命令行调试（控制台服务不会读取这两个值）
SWU_USERNAME=你的账号
SWU_PASSWORD=你的密码

# 控制台服务
APP_ENV=development
DATABASE_URL=sqlite:///./data/checkin.db
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# 生产环境请使用 APP_MASTER_KEY_FILE 或 systemd Credential，勿提交真实密钥。
# 生成命令：python -m server.cli generate-key
APP_MASTER_KEY=
# APP_MASTER_KEY_FILE=/run/credentials/check-new/app_master_key


